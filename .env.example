# Example .env - copy this to .env and fill in real secret values
# Do NOT commit your real .env to version control.

# Bot Configs
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# APIs
NEON_BOT_ID=your_neon_bot_id_here

# Discord Channel IDs
TRADE_CHANNEL_ID=123456789012345678
ANNOUNCEMENT_CHANNEL_ID=123456789012345678

# File Paths
# Path to the project root or where team data is stored on the host machine
TEAM_DATA_LOCATION=/path/to/opm-bot

# WhatsApp Group IDs
MAIN_GROUP_ID=123456789@g.us

# Recipients for WhatsApp trade/announcement updates (comma-separated)
WHATSAPP_TRADE_UPDATE_RECIPIENTS=123456789@g.us
WHATSAPP_ANNOUNCEMENT_RECIPIENTS=123456789@g.us

# Neonsportz
NEON_API_URL=https://neonsportz.com/api
NEON_LEAGUE_ABBREV=LEAGUE_ABBREV

# Waha Configs
WAHA_BASE_URL=http://localhost:3000
WAHA_API_KEY=your_waha_api_key_here

